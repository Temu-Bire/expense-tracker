# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=*

# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expense_tracker?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET="dev-jwt-access-secret-32-chars-long-minimum"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-32-chars-long-minimum"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10
